    "verificar": "npm run lint && npm run knip && npm run arquitetura"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.42.1",
    "vite": "^8.3.5"
  }
}
