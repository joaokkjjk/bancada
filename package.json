{
  "name": "bancada",
  "version": "1.0.0",
  "private": true,
  "description": "Toda a informática num lugar só. Grátis. Para sempre.",
  "type": "module",
  "license": "CC-BY-SA-4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:corrigir": "biome check --write .",
    "knip": "knip",
    "arquitetura": "depcruise src --config .dependency-cruiser.cjs",
